{
  "name": "@image-everything/backend",
  "version": "0.2.3",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "node node_modules/@typescript/native/bin/tsc --noEmit",
    "lint": "eslint src __tests__ --ext .ts",
    "format": "prettier --write \"{src,__tests__}/**/*.ts\"",
    "format:check": "prettier --check \"{src,__tests__}/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:compat": "node node_modules/typescript/bin/tsc --noEmit"
  },
  "dependencies": {
    "@image-everything/contracts": "workspace:*",
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/swagger": "^12.0.4",
    "@nestjs/throttler": "^6.7.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.10",
    "@nestjs/schematics": "^12.0.10",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.20",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "@typescript/native": "npm:typescript@^7.0.2"
  }
}
