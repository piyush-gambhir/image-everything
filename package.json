{
  "name": "image-everything",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "node scripts/dev.mjs",
    "dev:web": "node scripts/dev.mjs @image-everything/web",
    "dev:backend": "node scripts/dev.mjs @image-everything/backend",
    "dev:worker": "node scripts/dev.mjs @image-everything/image-worker",
    "dev:kill": "pnpm --filter @image-everything/web dev:kill",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format",
    "format:check": "pnpm -r format:check",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build && pnpm smoke",
    "smoke": "node scripts/smoke-v2.mjs",
    "pretest": "pnpm --filter @image-everything/contracts build",
    "test": "pnpm -r test",
    "pretypecheck": "pnpm --filter @image-everything/contracts build",
    "typecheck": "pnpm -r typecheck",
    "prepare": "pnpm --filter @image-everything/contracts build && husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7"
  },
  "lint-staged": {
    "web/**/*.{js,jsx,ts,tsx,md,mdx,css,scss,json,yml,yaml}": [
      "pnpm -F @image-everything/web exec prettier --write"
    ],
    "backend/**/*.{ts,js,json}": [
      "pnpm -F @image-everything/backend exec prettier --write"
    ],
    "packages/image-contracts/**/*.{ts,js,json,md}": [
      "pnpm -F @image-everything/contracts exec prettier --write"
    ],
    "workers/image-worker/**/*.{ts,js,json,md}": [
      "pnpm -F @image-everything/image-worker exec prettier --write"
    ],
    "web/**/*.{ts,tsx,js,jsx}": [
      "pnpm -F @image-everything/web exec eslint --fix"
    ],
    "backend/**/*.{ts,js}": [
      "pnpm -F @image-everything/backend exec eslint --fix"
    ],
    "packages/image-contracts/**/*.{ts,js}": [
      "pnpm -F @image-everything/contracts exec eslint --fix"
    ],
    "workers/image-worker/**/*.{ts,js}": [
      "pnpm -F @image-everything/image-worker exec eslint --fix"
    ]
  }
}
