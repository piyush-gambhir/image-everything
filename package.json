{
  "name": "image-everything",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "node scripts/dev.mjs",
    "dev:web": "node scripts/dev.mjs @image-everything/web",
    "dev:backend": "node scripts/dev.mjs @image-everything/backend",
    "dev:worker": "node scripts/dev.mjs @image-everything/image-worker",
    "dev:kill": "pnpm --filter @image-everything/web dev:kill",
    "lint": "turbo run lint",
    "format": "pnpm -r format",
    "format:check": "pnpm -r format:check",
    "check": "pnpm check:boundaries && turbo run lint typecheck test build && pnpm smoke",
    "smoke": "node scripts/smoke-v2.mjs",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "prepare": "test -d .git && husky || true",
    "check:boundaries": "node scripts/check-boundaries.mjs"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "turbo": "^2.11.7"
  },
  "lint-staged": {
    "web/**/*.{js,jsx,ts,tsx,md,mdx,css,scss,json,yml,yaml}": [
      "pnpm -F @image-everything/web exec prettier --write"
    ],
    "backend/**/*.{ts,js,json}": [
      "pnpm -F @image-everything/backend exec prettier --write"
    ],
    "packages/image-contracts/**/*.{ts,js,json,md}": [
      "pnpm -F @image-everything/contracts exec prettier --write"
    ],
    "workers/image-worker/**/*.{ts,js,json,md}": [
      "pnpm -F @image-everything/image-worker exec prettier --write"
    ],
    "web/**/*.{ts,tsx,js,jsx}": [
      "pnpm -F @image-everything/web exec eslint --fix"
    ],
    "backend/**/*.{ts,js}": [
      "pnpm -F @image-everything/backend exec eslint --fix"
    ],
    "packages/image-contracts/**/*.{ts,js}": [
      "pnpm -F @image-everything/contracts exec eslint --fix"
    ],
    "workers/image-worker/**/*.{ts,js}": [
      "pnpm -F @image-everything/image-worker exec eslint --fix"
    ]
  },
  "pnpm": {
    "overrides": {
      "minimatch@>=9.0.0 <9.0.7": "9.0.7",
      "yaml@>=2.0.0 <2.8.3": "2.8.3",
      "form-data@>=4.0.0 <4.0.6": "4.0.6",
      "ws@>=8.0.0 <8.21.0": "8.21.0",
      "ws@>=7.0.0 <7.5.11": "7.5.11",
      "@babel/core@>=7.0.0 <7.29.6": "7.29.6",
      "body-parser@>=2.0.0 <2.3.0": "2.3.0",
      "@hono/node-server@>=1.0.0 <1.19.15": "1.19.15",
      "browserslist@>=4.0.0 <4.28.7": "4.28.7",
      "@humanfs/node@>=0.16.0 <0.16.8": "0.16.8",
      "qs@>=6.0.0 <6.16.0": "6.16.0",
      "fflate@>=0.8.0 <0.8.3": "0.8.3",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "fast-uri@>=3.0.0 <3.1.8": "3.1.8",
      "@xhmikosr/decompress@>=10.0.0 <10.2.2": "10.2.2",
      "ip-address@>=10.0.0 <10.7.1": "10.7.1",
      "brace-expansion@>=1.0.0 <1.1.21": "1.1.21",
      "brace-expansion@>=2.0.0 <2.1.7": "2.1.7",
      "brace-expansion@>=5.0.0 <5.0.12": "5.0.12",
      "hono@>=4.0.0 <4.13.7": "4.13.7",
      "piscina@>=4.0.0 <4.9.4": "4.9.4",
      "http-cache-semantics@>=4.0.0 <4.3.0": "4.3.0",
      "flatted@>=3.0.0 <3.4.2": "3.4.2",
      "source-map-js@>=1.0.0 <1.2.2": "1.2.2",
      "proxy-addr@>=2.0.0 <2.0.8": "2.0.8",
      "postcss-selector-parser@>=7.0.0 <7.1.6": "7.1.6",
      "@modelcontextprotocol/sdk@>=1.0.0 <1.31.0": "1.31.0",
      "multer@>=2.0.0 <2.4.0": "2.4.0"
    }
  }
}
