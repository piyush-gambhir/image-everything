# API
API_PORT=3001
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_PER_MINUTE=120
# API_KEY=replace-with-a-long-random-token
IMAGE_WORKER_URL=http://localhost:3020
IMAGE_WORKER_TOKEN=replace-with-a-separate-private-worker-token
IMAGE_WORKER_DEADLINE_MS=30000

# Private execution worker
IMAGE_WORKER_PORT=3020
IMAGE_WORKER_MAX_REQUEST_BYTES=104857600

# Web (copy these two values to web/.env.local for local development)
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional convenience credential for a public demo. This value is bundled in
# browser JavaScript and must never be treated as a secret.
# NEXT_PUBLIC_API_KEY=
