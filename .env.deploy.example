# Copy to .env.deploy.production or .env.deploy.development and fill in.
# Both files are gitignored — never commit real values.

# Docker Hub — generate token at https://hub.docker.com/settings/security
DOCKERHUB_USERNAME=piyushgambhir
DOCKERHUB_TOKEN=

# Public URLs baked into the web image
NEXT_PUBLIC_API_URL=https://images-api.example.com
NEXT_PUBLIC_APP_URL=https://images.example.com
# Optional public-demo credential. This is embedded in browser JavaScript and
# must never be treated as a secret.
NEXT_PUBLIC_API_KEY=

# Private API → worker authentication
IMAGE_WORKER_TOKEN=

# Optional image-name overrides
# API_IMAGE_NAME=piyushgambhir/image-everything-api
# WORKER_IMAGE_NAME=piyushgambhir/image-everything-worker
# WEB_IMAGE_NAME=piyushgambhir/image-everything-web
# BUILD_PLATFORMS=linux/amd64,linux/arm64

# --- GCP Cloud Run (uncomment once a project is chosen) ---
# GCP_CONFIG=piyush-personal           # gcloud config configuration name
# GCP_PROJECT=                          # e.g. piyushgambhir-prod
# GCP_REGION=asia-south1
