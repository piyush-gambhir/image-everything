{
  "name": "@image-everything/image-worker",
  "version": "0.2.1",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && node node_modules/@typescript/native/bin/tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "node node_modules/@typescript/native/bin/tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src __tests__ --ext .ts",
    "format": "prettier --write \"{src,__tests__}/**/*.ts\"",
    "format:check": "prettier --check \"{src,__tests__}/**/*.ts\"",
    "typecheck:compat": "node node_modules/typescript/bin/tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@image-everything/contracts": "workspace:*",
    "archiver": "^8.0.0",
    "exifr": "^7.1.3",
    "heic-decode": "^2.1.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/archiver": "^8.0.0",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "@typescript/native": "npm:typescript@^7.0.2"
  },
  "engines": {
    "node": "26.x"
  }
}
